{
  "eslam-aboutaleb/polymarket-ai-trading": [
    {
      "workflow": "python.yml",
      "with": {
        "project-dir": "backend",
        "manager": "uv",
        "python-versions": "[\"3.11\"]",
        "coverage-source": "app",
        "coverage-min": 80
      },
      "secrets": {}
    },
    {
      "workflow": "integration.yml",
      "with": {
        "project-dir": "backend",
        "python-version": "3.11"
      },
      "secrets": {}
    },
    {
      "workflow": "browser.yml",
      "with": {
        "project-dir": "frontend",
        "manager": "npm",
        "node-version": "20",
        "test-script": "test:safety",
        "browsers": "chromium"
      },
      "secrets": {}
    },
    {
      "workflow": "workflow-lint.yml",
      "with": {},
      "secrets": {}
    },
    {
      "workflow": "security.yml",
      "with": {
        "languages": "[\"python\", \"javascript-typescript\", \"actions\"]",
        "dependency-severity": "high"
      },
      "secrets": {}
    }
  ],
  "eslam-aboutaleb/ragnor": [
    {
      "workflow": "python.yml",
      "with": {
        "project-dir": ".",
        "manager": "pip",
        "pip-extras": "test",
        "python-versions": "[\"3.11\", \"3.12\"]",
        "coverage-source": "src/ragnor",
        "coverage-min": 85,
        "build-distribution": "true"
      },
      "secrets": {}
    },
    {
      "workflow": "security.yml",
      "with": {
        "languages": "[\"python\", \"actions\"]",
        "config-file": ".github/codeql-config.yml"
      },
      "secrets": {}
    },
    {
      "workflow": "workflow-lint.yml",
      "with": {},
      "secrets": {}
    }
  ],
  "eslam-aboutaleb/llm-gateway": [
    {
      "workflow": "ci.yml",
      "with": {},
      "secrets": {}
    }
  ],
  "eslam-aboutaleb/ticket-classification": [
    {
      "workflow": "ci.yml",
      "with": {},
      "secrets": {
        "AI_EVAL_API_KEY": "${{ secrets.AI_EVAL_API_KEY }}",
        "PYPI_API_TOKEN": "${{ secrets.PYPI_API_TOKEN }}"
      }
    },
    {
      "workflow": "pr-description.yml",
      "with": {},
      "secrets": {}
    },
    {
      "workflow": "ml-benchmark.yml",
      "with": {
        "project-dir": ".",
        "target": "ci-benchmark",
        "python-version": "3.11",
        "provider": "openai",
        "dataset": "textoir_banking77",
        "report-file": "BENCHMARK_REPORT.md",
        "artifacts-dir": "data/artifacts"
      },
      "secrets": {
        "llm-gateway-api-key": "${{ secrets.LLM_GATEWAY_API_KEY }}"
      }
    }
  ]
}
